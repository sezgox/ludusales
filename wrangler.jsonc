{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ludusales",
  "compatibility_date": "2026-06-11",
  "assets": {
    "directory": "./dist/gamification-front/browser",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "ludusales-staging",
      "main": "./cloudflare/staging-worker.mjs",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "integracion.ludusales.com", "custom_domain": true }
      ],
      "assets": {
        "directory": "./dist/gamification-front/browser",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*"]
      },
      "services": [
        { "binding": "API", "service": "ludusales-api-staging" }
      ]
    }
  }
}
