{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ludusales",
  "compatibility_date": "2026-06-11",
  "build": {
    "command": "node -e \"if (process.env.WORKERS_CI_BRANCH === 'staging') throw new Error('Use npm run preview:staging for the staging branch.');\""
  },
  "assets": {
    "directory": "./dist/gamification-front/browser",
    "not_found_handling": "single-page-application"
  }
}
